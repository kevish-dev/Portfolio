# Copy to .env.local for local development, and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables.
# None of these are NEXT_PUBLIC_*, so they never reach the browser.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret key (sb_secret_...) or the legacy service_role key. Server-only.
SUPABASE_SECRET_KEY=

# Password for /admin. Use a long random passphrase.
ADMIN_PASSWORD=
# Random string of at least 32 characters, e.g. `openssl rand -base64 48`.
# Signs the admin session cookie and salts anonymous visitor hashes.
ADMIN_SESSION_SECRET=

# Optional: read-only GitHub token for the homepage GitHub widget (server-side only).
# Do NOT prefix it with NEXT_PUBLIC_, or it is bundled into the client JavaScript.
GITHUB_TOKEN=
